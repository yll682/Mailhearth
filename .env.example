# Copy to .env (docker compose reads it) or export in your shell.

# Public URL of this instance, used for absolute invite links. Must be
# https:// unless MAILHEARTH_SECURE_COOKIES=false.
MAILHEARTH_BASE_URL=https://mail.example.com

# Listen address and data directory (SQLite db, master key, uploads).
MAILHEARTH_LISTEN=:8080
MAILHEARTH_DATA_DIR=/data

# 32-byte key (base64 or hex) that encrypts the Purelymail API token and all
# mailbox app passwords. If unset, one is generated into $MAILHEARTH_DATA_DIR/master.key.
# Losing this key means every stored credential must be re-created.
#MAILHEARTH_MASTER_KEY=

# Creating the organisation on a fresh instance always requires a setup
# token. Leave unset to have one generated at startup and printed in the log
# (look for "FIRST-TIME SETUP"), or set your own here.
#MAILHEARTH_SETUP_TOKEN=

# Trust X-Forwarded-For / X-Forwarded-Host from your reverse proxy.
MAILHEARTH_TRUST_PROXY=true
# Addresses of the reverse proxies whose forwarding headers are trusted
# (comma-separated CIDRs or IPs). Default: loopback and private networks.
#MAILHEARTH_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
# Session cookies are Secure (HTTPS-only) by default. Set to false only for
# a plain-HTTP test instance; the dev stack defaults to false.
#MAILHEARTH_SECURE_COOKIES=true

# Mail servers on private, loopback or link-local addresses are refused
# unless their network is listed here (comma-separated CIDRs).
#MAILHEARTH_ALLOWED_MAIL_NETWORKS=10.20.0.0/16
# JSON file mapping CA bundle ids to PEM files, for mail servers with a
# private CA: {"1": "/etc/mailhearth/ca.pem"}
#MAILHEARTH_CA_BUNDLES_FILE=

# Resource limits for small hosts.
#MAILHEARTH_IMAP_MAX_CONNS=24
#MAILHEARTH_IMAP_IDLE_SECONDS=90
#MAILHEARTH_MAX_UPLOAD_MB=25
#MAILHEARTH_MAX_MESSAGE_MB=40
# Total size of one member's unsent uploads. Always enforced; must be at
# least MAX_UPLOAD_MB (raise it, up to 1048576, to loosen the limit).
MAILHEARTH_UPLOAD_QUOTA_MB=120
# Sliding session expiry (1-365 days).
#MAILHEARTH_SESSION_DAYS=14
# Absolute session lifetime (1-3650 days, not shorter than SESSION_DAYS).
#MAILHEARTH_SESSION_MAX_DAYS=30
#MAILHEARTH_INVITE_DAYS=7
#MAILHEARTH_LOG_LEVEL=info

# Development only: in-process fake Purelymail + IMAP + SMTP, no real account needed.
#MAILHEARTH_DEV_STACK=1
